{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": [
        "src/remote/**/*.ts"
      ],
      "rules": {
        "typescript/no-floating-promises": [
          "error",
          {
            "ignoreVoid": false
          }
        ]
      }
    }
  ],
  "rules": {
    "typescript/no-floating-promises": "off"
  }
}
