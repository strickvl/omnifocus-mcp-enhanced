{
  "name": "omnifocus-mcp-enhanced",
  "type": "module",
  "version": "1.7.0",
  "description": "\ud83d\ude80 NEW: Native Custom Perspective Access! Enhanced MCP server with OmniFocus custom perspective support, hierarchical task display, AI-optimized tool selection, and comprehensive task management",
  "main": "dist/server.js",
  "bin": {
    "omnifocus-mcp-enhanced": "./cli.cjs"
  },
  "scripts": {
    "build": "tsc && npm run copy-files && chmod 755 dist/server.js",
    "copy-files": "mkdir -p dist/utils/omnifocusScripts && cp src/utils/omnifocusScripts/*.js dist/utils/omnifocusScripts/",
    "start": "node dist/server.js",
    "dev": "tsc -w",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start:http": "node dist/remote/main.js",
    "lint": "oxlint --deny-warnings src/remote tests scripts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jqlts1/omnifocus-mcp-enhanced.git"
  },
  "homepage": "https://github.com/jqlts1/omnifocus-mcp-enhanced",
  "keywords": [
    "omnifocus",
    "mcp",
    "claude",
    "task-management",
    "ai",
    "subtasks",
    "enhanced",
    "productivity",
    "macos",
    "perspective",
    "perspective-api",
    "archivedfillterrules",
    "omnifocus-4.2",
    "breakthrough",
    "killer-feature"
  ],
  "author": {
    "name": "jqlts1",
    "email": "jqlts1@github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "license": "MIT"
}
